# Airfare Index System Environment Variables
# Copy this file to .env and fill in your values

# API Key for authenticating requests to the backend API
# Generate a secure random string for production use
API_KEY=your-secure-api-key-here

# Frontend origin for CORS (used by the API server)
FRONTEND_ORIGIN=http://localhost:5173

# Database path (relative to project root)
DATABASE_PATH=database/airfare_index.db

# Optional: Gemini API Key for AI chatbot
GEMINI_API_KEY=

# Optional: MoSPI CPI data file path
MOSPI_CPI_PATH=data/benchmarks/cpi_1337.xlsx